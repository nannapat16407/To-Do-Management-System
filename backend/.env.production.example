# Production Environment Configuration
# These values should be set via: fly secrets set KEY=VALUE
# Do NOT commit actual secrets to git

# Environment
APP_ENV=production

# Server - Fly.io assigns PORT automatically, do not override
PORT=8080

# Frontend URLs (comma-separated for multiple origins)
FRONTEND_URL=https://your-vercel-app.vercel.app

# Database - Use DATABASE_URL for Neon
# Get this from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# JWT Secret - Generate with: openssl rand -base64 32
JWT_SECRET=YOUR_GENERATED_JWT_SECRET_HERE
